@page
@model WorkoutTracker.Web.Pages.Programs.CreateModel
@{
    ViewData["Title"] = "Create New Program";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center mb-4">
            <a asp-page="Index" class="btn btn-outline-secondary me-3">
                <i class="bi bi-arrow-left"></i> Back to Programs
            </a>
            <h1 class="display-6 mb-0">Create New Program</h1>
        </div>

        <div class="card">
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Program.Name" class="form-label">Program Name *</label>
                        <input asp-for="Program.Name" class="form-control" placeholder="e.g., Upper Body Strength">
                        <span asp-validation-for="Program.Name" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Program.Description" class="form-label">Description (Optional)</label>
                        <textarea asp-for="Program.Description" class="form-control" rows="4" 
                                  placeholder="Describe the program goals, target audience, or any notes..."></textarea>
                        <span asp-validation-for="Program.Description" class="text-danger"></span>
                        <div class="form-text">
                            Add details about the program's purpose, target goals, or any special instructions.
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i> Create Program
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Help Section -->
        <div class="card mt-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-info-circle"></i> Tips for Creating Programs</h6>
            </div>
            <div class="card-body">
                <ul class="mb-0">
                    <li><strong>Be descriptive:</strong> "Upper Body Strength - Week 1" is better than just "Workout"</li>
                    <li><strong>Set clear goals:</strong> Describe what this program aims to achieve</li>
                    <li><strong>Include guidance:</strong> Add difficulty level and target audience in the description</li>
                    <li><strong>Plan ahead:</strong> You'll add exercises after creating the program</li>
                </ul>
            </div>
        </div>

        @if (Model.CopyFromProgram != null)
        {
            <div class="card mt-4 border-info">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0"><i class="bi bi-copy"></i> Copying from "@Model.CopyFromProgram.Name"</h6>
                </div>
                <div class="card-body">
                    <p class="mb-0">
                        After creating this program, all exercises from "@Model.CopyFromProgram.Name" 
                        will be automatically copied over with their sets, reps, and weights.
                    </p>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}