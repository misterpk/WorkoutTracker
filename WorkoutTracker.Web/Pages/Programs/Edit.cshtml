@page "{id:int}"
@model WorkoutTracker.Web.Pages.Programs.EditModel
@{
    ViewData["Title"] = "Edit Program";
}

@if (Model.Program == null)
{
    <div class="alert alert-warning">
        <h4>Program Not Found</h4>
        <p>The program you're trying to edit doesn't exist.</p>
        <a asp-page="Index" class="btn btn-primary">Back to Programs</a>
    </div>
}
else
{
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex align-items-center mb-4">
                <a asp-page="Details" asp-route-id="@Model.Program.Id" class="btn btn-outline-secondary me-3">
                    <i class="bi bi-arrow-left"></i> Back to Details
                </a>
                <h1 class="display-6 mb-0">Edit Program</h1>
            </div>

            <div class="card">
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="ProgramDto.Name" class="form-label">Program Name *</label>
                            <input asp-for="ProgramDto.Name" class="form-control" placeholder="e.g., Upper Body Strength">
                            <span asp-validation-for="ProgramDto.Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ProgramDto.Description" class="form-label">Description (Optional)</label>
                            <textarea asp-for="ProgramDto.Description" class="form-control" rows="4" 
                                      placeholder="Describe the program goals, target audience, or any notes..."></textarea>
                            <span asp-validation-for="ProgramDto.Description" class="text-danger"></span>
                            <div class="form-text">
                                Add details about the program's purpose, difficulty level, or target goals.
                            </div>
                        </div>


                        <div class="d-flex justify-content-between">
                            <a asp-page="Details" asp-route-id="@Model.Program.Id" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Program Info -->
            <div class="card mt-4">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-info-circle"></i> Program Information</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <small class="text-muted">
                                <div><strong>Exercises:</strong> @Model.Program.ProgramExercises.Count</div>
                                <div><strong>Total Sets:</strong> @Model.Program.ProgramExercises.Sum(pe => pe.PlannedSets)</div>
                                <div><strong>Created:</strong> @Model.Program.CreatedAt.ToString("MMM dd, yyyy")</div>
                            </small>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted">
                                @if (Model.Program.UpdatedAt != Model.Program.CreatedAt)
                                {
                                    <div><strong>Last Updated:</strong> @Model.Program.UpdatedAt.ToString("MMM dd, yyyy")</div>
                                }
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Warning about exercises -->
            @if (Model.Program.ProgramExercises.Any())
            {
                <div class="alert alert-info mt-4">
                    <h6><i class="bi bi-lightbulb"></i> Note about Exercise Management</h6>
                    <p class="mb-0">
                        This form only edits the program's basic information. To modify exercises, 
                        go back to the <a asp-page="Details" asp-route-id="@Model.Program.Id" class="alert-link">program details</a> 
                        page where you can add, edit, or remove exercises.
                    </p>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}