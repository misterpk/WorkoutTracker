@page "{id:int}"
@model WorkoutTracker.Web.Pages.Programs.DetailsModel
@{
    ViewData["Title"] = Model.Program?.Name ?? "Program Details";
}

@if (Model.Program == null)
{
    <div class="alert alert-warning">
        <h4>Program Not Found</h4>
        <p>The program you're looking for doesn't exist.</p>
        <a asp-page="Index" class="btn btn-primary">Back to Programs</a>
    </div>
}
else
{
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <div class="d-flex align-items-center mb-2">
                <a asp-page="Index" class="btn btn-outline-secondary me-3">
                    <i class="bi bi-arrow-left"></i> Back to Programs
                </a>
                <h1 class="display-6 mb-0">@Model.Program.Name</h1>
            </div>
            
            @if (!string.IsNullOrEmpty(Model.Program.Description))
            {
                <p class="lead text-muted">@Model.Program.Description</p>
            }
        </div>
        
        <div class="btn-group" role="group">
            <a asp-page="Edit" asp-route-id="@Model.Program.Id" class="btn btn-outline-secondary">
                <i class="bi bi-pencil"></i> Edit Program
            </a>
            <a asp-page="AddExercise" asp-route-id="@Model.Program.Id" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add Exercise
            </a>
        </div>
    </div>

    <!-- Program Stats -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-primary mb-1">@Model.Program.ProgramExercises.Count</h3>
                    <p class="card-text text-muted mb-0">Exercises</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-success mb-1">@Model.Program.ProgramExercises.Sum(pe => pe.PlannedSets)</h3>
                    <p class="card-text text-muted mb-0">Total Sets</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-info mb-1">@Model.CalculateEstimatedDuration() min</h3>
                    <p class="card-text text-muted mb-0">Est. Duration</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-warning mb-1">@Model.Program.CreatedAt.ToString("MMM dd")</h3>
                    <p class="card-text text-muted mb-0">Created</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Exercises Section -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Program Exercises</h5>
            @if (!Model.Program.ProgramExercises.Any())
            {
                <a asp-page="AddExercise" asp-route-id="@Model.Program.Id" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-circle"></i> Add First Exercise
                </a>
            }
        </div>
        <div class="card-body">
            @if (Model.Program.ProgramExercises.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th width="5%">#</th>
                                <th width="30%">Exercise</th>
                                <th width="15%">Sets × Reps</th>
                                <th width="15%">Weight</th>
                                <th width="15%">Rest</th>
                                <th width="20%">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var programExercise in Model.Program.ProgramExercises.OrderBy(pe => pe.Order))
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-light text-dark">@programExercise.Order</span>
                                    </td>
                                    <td>
                                        <div>
                                            <strong>@programExercise.Exercise.Name</strong>
                                            <div class="small text-muted">@programExercise.Exercise.PrimaryMuscle</div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-bold">@programExercise.PlannedSets × @programExercise.PlannedReps</span>
                                    </td>
                                    <td>
                                        @if (programExercise.PlannedWeight > 0)
                                        {
                                            <span>@programExercise.PlannedWeight lbs</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Bodyweight</span>
                                        }
                                    </td>
                                    <td>
                                        @if (programExercise.PlannedRestTimeSeconds > 0)
                                        {
                                            <span>@(programExercise.PlannedRestTimeSeconds / 60)m @(programExercise.PlannedRestTimeSeconds % 60)s</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not set</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-page="EditExercise" asp-route-id="@programExercise.Id" 
                                               class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                                    onclick="moveExercise(@programExercise.Id, 'up')" 
                                                    @(programExercise.Order == 1 ? "disabled" : "")>
                                                <i class="bi bi-arrow-up"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                                    onclick="moveExercise(@programExercise.Id, 'down')"
                                                    @(programExercise.Order == Model.Program.ProgramExercises.Count ? "disabled" : "")>
                                                <i class="bi bi-arrow-down"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger btn-sm"
                                                    onclick="removeExercise(@programExercise.Id, '@programExercise.Exercise.Name')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                
                <!-- Quick Actions -->
                <div class="d-flex justify-content-between mt-3">
                    <div>
                        <a asp-page="AddExercise" asp-route-id="@Model.Program.Id" class="btn btn-outline-primary">
                            <i class="bi bi-plus-circle"></i> Add Another Exercise
                        </a>
                    </div>
                    <div>
                        <a asp-page="/Workouts/Create" asp-route-programId="@Model.Program.Id" class="btn btn-success">
                            <i class="bi bi-play-circle"></i> Start Workout
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="bi bi-plus-circle-dotted" style="font-size: 3rem; color: #6c757d;"></i>
                    <h5 class="mt-3">No exercises in this program yet</h5>
                    <p class="text-muted">Add exercises to build your workout program.</p>
                    <a asp-page="AddExercise" asp-route-id="@Model.Program.Id" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Add First Exercise
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Actions Section -->
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-title">Program Actions</h6>
                    <div class="d-grid gap-2">
                        <a asp-page="Create" asp-route-copyFromId="@Model.Program.Id" class="btn btn-outline-info">
                            <i class="bi bi-copy"></i> Duplicate Program
                        </a>
                        <a asp-page="Delete" asp-route-id="@Model.Program.Id" class="btn btn-outline-danger">
                            <i class="bi bi-trash"></i> Delete Program
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-title">Quick Info</h6>
                    <small class="text-muted">
                        <div>Created: @Model.Program.CreatedAt.ToString("MMMM dd, yyyy 'at' h:mm tt")</div>
                        @if (Model.Program.UpdatedAt != Model.Program.CreatedAt)
                        {
                            <div>Last updated: @Model.Program.UpdatedAt.ToString("MMMM dd, yyyy 'at' h:mm tt")</div>
                        }
                    </small>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function moveExercise(programExerciseId, direction) {
            // This would typically be a POST request to reorder exercises
            console.log(`Moving exercise ${programExerciseId} ${direction}`);
            // For now, show a message
            alert(`Exercise reordering will be implemented in a future update.`);
        }

        function removeExercise(programExerciseId, exerciseName) {
            if (confirm(`Are you sure you want to remove "${exerciseName}" from this program?`)) {
                // This would typically be a POST request to remove the exercise
                console.log(`Removing exercise ${programExerciseId}`);
                // For now, show a message
                alert(`Exercise removal will be implemented in a future update.`);
            }
        }
    </script>
}