@page "{id:int}"
@model WorkoutTracker.Web.Pages.Exercises.DeleteModel
@{
    ViewData["Title"] = $"Delete {Model.Exercise.Name}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center mb-4">
            <a asp-page="Details" asp-route-id="@Model.Exercise.Id" class="btn btn-outline-secondary me-3">
                <i class="bi bi-arrow-left"></i> Back to Details
            </a>
            <h1 class="display-6 mb-0 text-danger">Delete Exercise</h1>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle"></i>
                @Model.ErrorMessage
            </div>
        }

        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">
                    <i class="bi bi-exclamation-triangle"></i> 
                    Are you sure you want to delete this exercise?
                </h5>
            </div>
            <div class="card-body">
                <!-- Exercise Summary -->
                <div class="row mb-4">
                    <div class="col-md-8">
                        <h4 class="mb-2">@Model.Exercise.Name</h4>
                        <p class="mb-2">
                            <span class="badge bg-secondary">@Model.Exercise.PrimaryMuscle</span>
                        </p>
                        @if (!string.IsNullOrEmpty(Model.Exercise.Description))
                        {
                            <p class="text-muted mb-0">@Model.Exercise.Description</p>
                        }
                    </div>
                    <div class="col-md-4">
                        <div class="text-end">
                            <small class="text-muted">
                                Created: @Model.Exercise.CreatedAt.ToString("MMM dd, yyyy")<br>
                                Updated: @Model.Exercise.UpdatedAt.ToString("MMM dd, yyyy")
                            </small>
                        </div>
                    </div>
                </div>

                <!-- Warning Message -->
                <div class="alert alert-warning" role="alert">
                    <h6 class="alert-heading">
                        <i class="bi bi-exclamation-triangle"></i> Warning: This action cannot be undone
                    </h6>
                    <p class="mb-2">Deleting this exercise will:</p>
                    <ul class="mb-3">
                        <li>Permanently remove it from your exercise library</li>
                        <li>Remove it from any programs that use this exercise</li>
                        <li>Remove it from any workout history (if used in past workouts)</li>
                        <li>Delete all associated performance data and sets</li>
                    </ul>
                    <p class="mb-0">
                        <strong>Consider editing the exercise instead if you just want to update its details.</strong>
                    </p>
                </div>

                <!-- Impact Assessment (Placeholder for future) -->
                <div class="alert alert-info" role="alert">
                    <h6 class="alert-heading">
                        <i class="bi bi-info-circle"></i> Impact Assessment
                    </h6>
                    <div class="row text-center">
                        <div class="col-4">
                            <div class="h5 mb-1">0</div>
                            <small>Programs affected</small>
                        </div>
                        <div class="col-4">
                            <div class="h5 mb-1">0</div>
                            <small>Workouts affected</small>
                        </div>
                        <div class="col-4">
                            <div class="h5 mb-1">0</div>
                            <small>Sets to be lost</small>
                        </div>
                    </div>
                    <hr>
                    <small class="text-muted">
                        Impact calculation will be added in future versions.
                    </small>
                </div>

                <!-- Action Buttons -->
                <form method="post" class="d-inline">
                    <div class="d-flex justify-content-between">
                        <div>
                            <a asp-page="Details" asp-route-id="@Model.Exercise.Id" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                            <a asp-page="Edit" asp-route-id="@Model.Exercise.Id" class="btn btn-primary">
                                <i class="bi bi-pencil"></i> Edit Instead
                            </a>
                        </div>
                        <button type="submit" class="btn btn-danger btn-delete" 
                                data-confirm-message="Are you absolutely sure you want to delete '@Model.Exercise.Name'? This cannot be undone.">
                            <i class="bi bi-trash"></i> Yes, Delete Exercise
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Alternative Actions -->
        <div class="card mt-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-lightbulb"></i> Alternative Actions</h6>
            </div>
            <div class="card-body">
                <p class="mb-3">Instead of deleting, you might want to:</p>
                <div class="row">
                    <div class="col-md-6">
                        <div class="d-flex align-items-start mb-3">
                            <i class="bi bi-pencil text-primary me-3 mt-1"></i>
                            <div>
                                <h6 class="mb-1">Edit the Exercise</h6>
                                <p class="small text-muted mb-2">Update the name, description, or muscle group instead of deleting.</p>
                                <a asp-page="Edit" asp-route-id="@Model.Exercise.Id" class="btn btn-sm btn-outline-primary">Edit Exercise</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-plus-circle text-success me-3 mt-1"></i>
                            <div>
                                <h6 class="mb-1">Create a Variation</h6>
                                <p class="small text-muted mb-2">Create a new exercise based on this one with different equipment or technique.</p>
                                <a asp-page="Create" class="btn btn-sm btn-outline-success">Add New Exercise</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
